[Unit]
Description=Qwen3.8-27B NVFP4 private vLLM server on DGX Spark
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/docker run --rm --name travel-qwen38 --gpus all --network host --ipc=host --shm-size 8g --memory 80g --memory-swap 80g -v /home/Developer/models/qwen38-inferact:/models/qwen38:ro -v /home/Developer/models/qwen38-cache:/root/.cache:rw vllm/vllm-openai:qwen38 --model /models/qwen38 --served-model-name qwen38-27b --host 127.0.0.1 --port 8192 --tensor-parallel-size 1 --max-model-len 16384 --max-num-seqs 1 --max-num-batched-tokens 4096 --gpu-memory-utilization 0.45 --kv-cache-dtype auto --reasoning-parser qwen3
ExecStop=/usr/bin/docker stop --time 30 travel-qwen38
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=default.target
