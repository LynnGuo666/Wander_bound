{
  "name": "travel-memory-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env server/index.mjs\" \"vite --host 127.0.0.1\"",
    "dev:server": "node --env-file-if-exists=.env server/index.mjs",
    "agent:cli": "node --env-file-if-exists=.env server/cli.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "ios:generate": "cd ios && xcodegen generate",
    "ios:open": "open ios/TravelMemory.xcodeproj",
    "test": "node --test",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
