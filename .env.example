# 服务端供应商密钥。留空时对应供应商显示“未接入”，不会生成虚构报价。
AMAP_WEB_KEY=
DIDA_API_KEY=
DUFFEL_API_KEY=
# 飞猪 FlyAI Skill/CLI：留空时可使用受限体验模式，部分价格会被遮蔽。
FLYAI_API_KEY=
# 途牛 MCP CLI：填写开放平台 Key，或在本机完成 OAuth 后将 TUNIU_USE_OAUTH 设为 1。
TUNIU_API_KEY=
TUNIU_USE_OAUTH=0
# Step 5 Preview 旅行 Agent。密钥仅放在服务端，不提交到仓库。
STEPFUN_API_KEY=
# 可选：官方默认 https://api.stepfun.com/v1；仅用于兼容代理或私网网关。
STEPFUN_BASE_URL=https://api.stepfun.com/v1
PORT=4174
HOST=127.0.0.1
# 网页与 API 分域部署时填写唯一允许的网页 Origin，例如 https://travel.example。
# 本地 Vite 代理和同域部署无需配置。
CORS_ALLOWED_ORIGIN=
