# 服务端供应商密钥。留空时对应供应商显示“未接入”，不会生成虚构报价。
AMAP_WEB_KEY=
DIDA_API_KEY=
DUFFEL_API_KEY=
# Docker OTA MCP 地址；在 Spark 上运行 deploy/ota-mcp/compose.yml 后使用回环地址。
TRAVEL_OTA_MCP_URL=
# 飞猪 FlyAI：留空时可使用受限体验模式，部分价格会被遮蔽。
FLYAI_API_KEY=
# 途牛 MCP：填写开放平台 Key。凭据只随单次 MCP 请求传给容器。
TUNIU_API_KEY=
# Step Plan 的 Step 5 Preview 旅行 Agent。密钥仅放在服务端，不提交到仓库。
STEPFUN_API_KEY=
# Step Plan 中国区入口；其他区域或兼容网关可按账户文档调整。
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
PORT=4174
HOST=127.0.0.1
# 网页与 API 分域部署时填写唯一允许的网页 Origin，例如 https://travel.example。
# 本地 Vite 代理和同域部署无需配置。
CORS_ALLOWED_ORIGIN=
# 相册与回忆短片只在私有服务开放。生成独立高强度令牌（例如 openssl rand -hex 32）。
MEDIA_API_TOKEN=
# 私有照片、修图版本与短片的存储目录；留空时使用项目 data/media。
MEDIA_STORAGE_DIR=
# 本地 MiniMax H3 ComfyUI 服务和导出的 I2V API 工作流；两项都配置后才开放短片任务。
SPARK_COMFY_URL=
SPARK_H3_WORKFLOW_FILE=
