# 服务端供应商密钥。留空时对应供应商显示“未接入”，不会生成虚构报价。
AMAP_WEB_KEY=
DIDA_API_KEY=
DUFFEL_API_KEY=
# Docker OTA MCP 地址；在 Spark 上运行 deploy/ota-mcp/compose.yml 后使用回环地址。
TRAVEL_OTA_MCP_URL=
# Node 数据聚合 MCP（deploy/travel-data-mcp，Spark 4179；本地经 SSH 隧道 14179）。
TRAVEL_DATA_MCP_URL=
# 12306 社区 MCP（非铁路官方维护）；Docker compose 中仅绑定服务器回环端口 4177。
TRAVEL_12306_MCP_URL=
# Docker 道旅 MCP（deploy/dida-mcp，回环 4178）；未配置时不查询道旅。
TRAVEL_DIDA_MCP_URL=
# 飞猪 FlyAI：留空时可使用受限体验模式，部分价格会被遮蔽。
FLYAI_API_KEY=
# 途牛 MCP：填写开放平台 Key。凭据只随单次 MCP 请求传给容器。
TUNIU_API_KEY=
# Step Plan 的 Step 5 Preview 旅行 Agent。密钥仅放在服务端，不提交到仓库。
STEPFUN_API_KEY=
# Step Plan 中国区入口；其他区域或兼容网关可按账户文档调整。
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
# 相册与回忆短片只在私有服务开放。生成独立高强度令牌（例如 openssl rand -hex 32）。
MEDIA_API_TOKEN=
# 私有照片、修图版本与短片的存储目录；留空时使用项目 data/media。
MEDIA_STORAGE_DIR=
TRIP_STORAGE_DIR=
PY_PORT=4176
# 本地 MiniMax H3 ComfyUI 服务和导出的 I2V API 工作流；两项都配置后才开放短片任务。
SPARK_COMFY_URL=
SPARK_H3_WORKFLOW_FILE=
# Spark 上的多模态模型（照片精修建议 + 照片选优打标共用同一台）。BASE_URL 指向
# spark-tunnel.sh 转发的本地入口；MODEL 必须和服务端 --served-model-name 一致；
# TIMEOUT 是单次读超时，实测一次建议 100 秒起。
DGX_VISION_BASE_URL=http://127.0.0.1:18192/v1
DGX_VISION_MODEL=qwen38-27b
DGX_VISION_TOKEN=
DGX_VISION_TIMEOUT=180
# 本地 Qwen-Image-2.1 ComfyUI 服务和图像编辑 API 工作流；两项都配置后开放创意重绘。
SPARK_QWEN_COMFY_URL=
SPARK_QWEN_IMAGE_WORKFLOW_FILE=
